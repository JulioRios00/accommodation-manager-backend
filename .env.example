# Local development — use individual DB_ vars
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=accommodation

# Production (NeonDB / any PostgreSQL) — overrides individual DB_ vars when set
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

PORT=3001
NODE_ENV=development

# Auth
CLERK_SECRET_KEY=sk_test_...
# JWT public key (Clerk Dashboard → Configure → API Keys → "Advanced" → JWT public key).
# Optional but recommended: lets token verification happen locally instead of fetching
# Clerk's JWKS over the network on every request, which was causing intermittent 401s.
CLERK_JWT_KEY=-----BEGIN PUBLIC KEY-----...

# Monitoring
SENTRY_DSN=https://your-key@sentry.io/your-project-id
# Optional — overrides the environment tag Sentry reports events under.
# Defaults to NODE_ENV (then "development") if unset.
# SENTRY_ENVIRONMENT=development

# CORS — set to your frontend URL in production
CORS_ORIGIN=http://localhost:3000
